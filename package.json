{
  "name": "starbox",
  "version": "2.8.1",
  "description": "StarBox",
  "main": "./out/main/index.js",
  "author": "com.wsudo.starbox",
  "homepage": "https://starbox.wsudo.com",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "build:server": "ts-node --esm --project tsconfig.node.json scripts/build-server.ts",
    "build:server:console": "ts-node --esm --project tsconfig.node.json scripts/build-server.ts --console",
    "build:app:win": "ts-node --esm --project tsconfig.node.json scripts/build-app.ts win",
    "build:app:mac": "ts-node --esm --project tsconfig.node.json scripts/build-app.ts mac",
    "build:app:linux": "ts-node --esm --project tsconfig.node.json scripts/build-app.ts linux",
    "build:app": "ts-node --esm --project tsconfig.node.json scripts/build-app.ts"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "fs-extra": "^11.3.5",
    "iconv-lite": "^0.7.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/vue-form": "^1.33.0",
    "@tanstack/vue-table": "^8.21.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.9.3",
    "@types/semver": "^7.7.1",
    "@vavt/cm-extension": "^1.11.2",
    "@vavt/v3-extension": "^5.0.0",
    "@vee-validate/zod": "^4.15.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-icon-builder": "^2.0.1",
    "electron-vite": "^5.0.0",
    "jsoneditor": "^10.4.3",
    "lodash-es": "^4.18.1",
    "lucide-vue-next": "^1.0.0",
    "md-editor-v3": "^6.5.1",
    "pinia": "^3.0.4",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "reka-ui": "^2.9.10",
    "semver": "^7.8.4",
    "shiki": "^4.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "uuid": "^14.0.0",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.1",
    "vite": "^8.0.16",
    "vite-plugin-remove-console": "^2.2.0",
    "vite-svg-loader": "^5.1.1",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^3.3.5",
    "vue-virtual-scroller": "3.0.4",
    "vuedraggable-es-fix": "^1.0.1",
    "wavesurfer.js": "^7.12.8",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
